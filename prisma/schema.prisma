/**
 * Prisma Schema — طبق بخش ۴ docs/ARCHITECTURE.md (ERD کامل v2.0)
 * ---------------------------------------------------------------
 * موتور: PostgreSQL 16 · همه مبالغ: Integer (IRT) · همه زمان‌ها: DateTime(utc)
 *
 * انحراف‌های مستند M1 (فیلدهای نمایشی فاز ۱ که در ERD تجاری نیستند و تا M2+
 * برای برابری صددرصدی UI نگه داشته می‌شوند):
 *  - Product.specs/care/suitableFor/features (نمایشی) · Product.rating/reviewCount
 *    (denormalized؛ در M3 از Reviewهای تاییدشده بازمحاسبه می‌شود)
 *  - Product.searchKey (ستون نرمال‌شده برای FTS فارسی — بخش ۱۷ سند)
 *  - Category.seoText · Size.dimensions/gsm · Review.verifiedPurchase
 */

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/* ------------------------------------------------------------------ */
/* ۴.۰ Enumهای سیستم                                                    */
/* ------------------------------------------------------------------ */

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum ShipmentStatus {
  PENDING
  READY
  SHIPPED
  IN_TRANSIT
  DELIVERED
  FAILED
  RETURNED
}

enum ReservationStatus {
  ACTIVE
  CONVERTED
  RELEASED
  EXPIRED
}

enum RefundStatus {
  REQUESTED
  PROCESSING
  SUCCEEDED
  FAILED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CouponType {
  PERCENT
  FIXED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

/* ------------------------------------------------------------------ */
/* ۴.۸ M5 — دفتر پیامک‌ها (پیامک‌های آزمایشی/واقعی)                      */
/* ------------------------------------------------------------------ */

enum SmsLogStatus {
  SENT
  FAILED
}

model SmsLog {
  id         String       @id @default(cuid())
  to         String       @db.VarChar(15)
  text       String
  tag        String       @db.VarChar(50) // order-created · payment-succeeded · …
  status     SmsLogStatus @default(SENT)
  provider   String       @db.VarChar(30)
  providerId String?
  /** شماره سفارش مرتبط — بدون FK (پیامک ممکن است بدون سفارش باشد مثل خوش‌آمد) */
  orderId    String?
  error      String?
  createdAt  DateTime     @default(now())

  @@index([createdAt])
  @@index([tag, createdAt])
}

/* ------------------------------------------------------------------ */
/* ۴.۱ دسترسی، نقش‌ها و احراز هویت                                       */
/* ------------------------------------------------------------------ */

model User {
  id           String    @id @default(cuid())
  phone        String    @unique @db.VarChar(15)
  passwordHash String?
  name         String?
  email        String?   @unique
  roleId       String?
  isActive     Boolean   @default(true)
  // 2FA/TOTP — زیرساخت M2 (بخش ۹.۳ سند): آماده ولی غیرفعال تا دستور مالک
  totpSecret   String?
  totpEnabled  Boolean   @default(false)
  lastLoginAt  DateTime?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  role          Role?       @relation(fields: [roleId], references: [id], onDelete: SetNull)
  sessions      Session[]
  addresses     Address[]
  cart          Cart?
  orders        Order[]
  reviews       Review[]
  journalPosts  JournalPost[]
  wishlists     WishlistItem[]
  redemptions   CouponRedemption[]
  refunds       Refund[]          @relation("RefundActor")
  mediaObjects  MediaObject[]
  auditLogs     AuditLog[]
  settings      Setting[]

  @@index([roleId])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  title       String
  permissions String[]
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}

model Session {
  id               String    @id @default(cuid())
  sessionToken     String    @unique
  userId           String
  isAdminSession   Boolean   @default(false)
  ip               String?
  userAgent        String?
  idleAt           DateTime?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model OtpCode {
  id           String    @id @default(cuid())
  phone        String    @db.VarChar(15)
  codeHash     String
  expiresAt    DateTime
  attemptCount Int       @default(0)
  usedAt       DateTime?
  ip           String?
  createdAt    DateTime  @default(now())

  @@index([phone, createdAt])
}

/* ------------------------------------------------------------------ */
/* ۴.۲ کاتالوگ محصول                                                    */
/* ------------------------------------------------------------------ */

model Product {
  id               String        @id @default(cuid())
  slug             String        @unique
  name             String
  shortDescription String        @db.VarChar(300)
  description      String
  status           ProductStatus @default(DRAFT)
  categoryId       String
  // برچسب‌ها محاسباتی‌اند (ADR 011) — ستون badges حذف شد؛ منبع: store.badgeRules + فروش/تاریخ/موجودی
  deletedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // فیلدهای نمایشی فاز ۱ (انحراف مستند M1)
  specs       Json?
  care        String[]
  suitableFor String[]
  features    String[]
  rating      Float     @default(0)
  reviewCount Int       @default(0)
  sortOrder   Int       @default(0)
  /// نام + shortDescription + description نرمال‌شده با normalize-fa — برای FTS فارسی (بخش ۱۷)
  searchKey   String    @default("")

  category     Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants     Variant[]
  images       ProductImage[]
  collections  CollectionProduct[]
  reviews      Review[]
  wishlists    WishlistItem[]

  @@index([categoryId])
  @@index([status])
  @@index([name])
}

model Variant {
  id             String    @id @default(cuid())
  productId      String
  colorId        String?
  sizeId         String?
  sku            String    @unique
  price          Int
  compareAtPrice Int?
  stock          Int       @default(0)
  reserved       Int       @default(0)
  // واریانت اصلی (نماینده sku/قیمت نمایشی محصول) = sortOrder کمتر
  sortOrder      Int       @default(0)
  isActive       Boolean   @default(true)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  product     Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  color       Color?                @relation(fields: [colorId], references: [id], onDelete: Restrict)
  size        Size?                 @relation(fields: [sizeId], references: [id], onDelete: Restrict)
  reservations InventoryReservation[]
  cartItems   CartItem[]

  @@index([productId])
  @@index([sku])
}

model Color {
  id   String @id
  name String
  hex  String @unique

  variants Variant[]
}

model Size {
  id         String @id
  name       String
  sortOrder  Int    @default(0)
  dimensions String?
  gsm        Int?

  variants Variant[]
}

model ProductImage {
  id         String @id @default(cuid())
  productId  String
  // بدون UNIQUE: تصاویر مشترک بین محصولات مجازند (لایف‌استایل) —
  // dedupe در MediaObject.registry انجام می‌شود (یادداشت M1 روی ERD)
  storageKey String
  alt        String?
  sortOrder  Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([storageKey])
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  imageKey    String?
  sortOrder   Int       @default(0)
  deletedAt   DateTime?
  seoText     String?

  products Product[]

  @@index([sortOrder])
}

model Collection {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  imageKey    String?
  sortOrder   Int       @default(0)
  deletedAt   DateTime?

  products CollectionProduct[]

  @@index([sortOrder])
}

model CollectionProduct {
  collectionId String
  productId    String
  sortOrder    Int    @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([productId])
}

/* ------------------------------------------------------------------ */
/* ۴.۳ فروش، سفارش و پرداخت                                             */
/* ------------------------------------------------------------------ */

model Address {
  id         String    @id @default(cuid())
  userId     String
  fullName   String
  phone      String    @db.VarChar(15)
  province   String
  city       String
  postalCode String    @db.VarChar(10)
  line       String
  isDefault  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  updatedAt DateTime @updatedAt

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int
  createdAt DateTime @default(now())

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
}

model Coupon {
  id           String     @id @default(cuid())
  code         String     @unique
  type         CouponType
  value        Int
  minSubtotal  Int?
  maxDiscount  Int?
  usageLimit   Int?
  perUserLimit Int?
  usedCount    Int        @default(0)
  startsAt     DateTime?
  expiresAt    DateTime?
  isActive     Boolean    @default(true)
  deletedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  redemptions CouponRedemption[]

  @@index([isActive])
}

model CouponRedemption {
  id       String   @id @default(cuid())
  couponId String
  orderId  String
  userId   String?
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([couponId, orderId])
  @@index([couponId])
  @@index([userId])
}

model Order {
  id            String      @id @default(cuid())
  code          String      @unique @db.VarChar(10)
  userId        String?
  phone         String      @db.VarChar(15)
  status        OrderStatus @default(PENDING)
  subtotal      Int
  discountTotal Int
  shippingTotal Int
  taxTotal      Int         @default(0)
  grandTotal    Int
  currency      String      @default("IRT") @db.VarChar(3)
  shippingAddress Json
  couponCodeSnapshot String?
  note          String?
  placedAt      DateTime
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user          User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  reservations  InventoryReservation[]
  payments      Payment[]
  refunds       Refund[]
  shipments     Shipment[]
  redemptions   CouponRedemption[]

  @@index([userId, createdAt])
  @@index([status])
}

model OrderItem {
  id                  String @id @default(cuid())
  orderId             String
  productId           String
  variantId           String
  productNameSnapshot String
  variantNameSnapshot String
  skuSnapshot         String
  imageUrlSnapshot    String?
  unitPrice           Int
  quantity            Int
  discount            Int    @default(0)
  total               Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

model InventoryReservation {
  id         String            @id @default(cuid())
  variantId  String
  orderId    String?
  qty        Int
  status     ReservationStatus @default(ACTIVE)
  expiresAt  DateTime
  createdAt  DateTime          @default(now())
  releasedAt DateTime?

  variant Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([variantId])
  @@index([status, expiresAt])
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String
  provider      String        @db.VarChar(30)
  authority     String        @unique
  transactionId String?       @unique
  amount        Int
  status        PaymentStatus @default(PENDING)
  metadata      Json?
  createdAt     DateTime      @default(now())
  verifiedAt    DateTime?

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refunds Refund[]

  @@index([orderId])
  @@index([status])
}

model Refund {
  id          String       @id @default(cuid())
  paymentId   String
  orderId     String
  amount      Int
  reason      String
  status      RefundStatus @default(REQUESTED)
  providerRef String?
  /** پیام خطای درگاه در صورت FAILED — برای نمایش ادمین */
  error       String?
  actorId     String?
  createdAt   DateTime     @default(now())
  succeededAt DateTime?

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actor   User?   @relation("RefundActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([paymentId])
}

model Shipment {
  id              String         @id @default(cuid())
  orderId         String
  carrier         String?
  trackingCode    String?
  status          ShipmentStatus @default(PENDING)
  addressSnapshot Json
  shippedAt       DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime       @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([status])
}

/* ------------------------------------------------------------------ */
/* ۴.۴ محتوا و سیستم                                                    */
/* ------------------------------------------------------------------ */

model Review {
  id               String       @id @default(cuid())
  productId        String
  userId           String?
  authorName       String
  rating           Int
  body             String
  status           ReviewStatus @default(PENDING)
  publishedAt      DateTime?
  verifiedPurchase Boolean      @default(false)
  createdAt        DateTime     @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, status])
}

model JournalPost {
  id           String        @id @default(cuid())
  slug         String        @unique
  title        String
  excerpt      String        @db.VarChar(500)
  bodyMarkdown String
  coverKey     String?
  topic        String
  /** SEO-03 (فاز ۵) — عنوان CTA اختصاصی هر مقاله؛ null = عنوان پیش‌فرض */
  ctaTitle     String?
  readingMinutes Int
  status       ContentStatus @default(DRAFT)
  publishedAt  DateTime?
  authorId     String?
  deletedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
}

model FaqItem {
  id        String  @id @default(cuid())
  question  String
  answer    String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  @@index([sortOrder])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?

  updatedByUser User? @relation(fields: [updatedBy], references: [id], onDelete: SetNull)
}

/// پیام‌های فرم تماس + ایمیل‌های خبرنامه — جایگزین توست فیک فاز ۱ (ADR 009)
model ContactMessage {
  id        String   @id @default(cuid())
  kind      String // CONTACT | NEWSLETTER
  email     String
  name      String?
  phone     String?
  subject   String?
  message   String?
  status    String   @default("NEW") // NEW | READ
  createdAt DateTime @default(now())

  @@index([kind, status, createdAt])
}

model MediaObject {
  id         String   @id @default(cuid())
  storageKey String   @unique
  mime       String   @db.VarChar(100)
  sizeBytes  Int
  width      Int?
  height     Int?
  sha256     String   @unique
  uploadedBy String?
  createdAt  DateTime @default(now())

  uploadedByUser User? @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String   @db.VarChar(100)
  entityType String   @db.VarChar(50)
  entityId   String
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model OutboxEvent {
  id          String       @id @default(cuid())
  type        String       @db.VarChar(100)
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  lastError   String?
  availableAt DateTime
  processedAt DateTime?
  /** زمان claim توسط worker — برای بازیابی رخداد گمشده پس از crash */
  claimedAt   DateTime?
  createdAt   DateTime     @default(now())

  @@index([status, availableAt])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}
