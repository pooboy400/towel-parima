# مثال متغیرهای محیطی — کپی به .env
# dev محلی: docker compose up -d (فایل docker-compose.yml) یا scripts/pg.sh
DATABASE_URL="postgresql://prima:prima_dev_only@127.0.0.1:5432/prima?schema=public"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# TRUSTED_PROXY_CIDR — فقط رنج IP پروکسی معتمد جلوی اپ (مثلاً Caddy).
#   تنظیم‌نشده = دسترسی مستقیم به سرور: هدرهای X-Forwarded-For/x-real-ip هرگز
#   معتبر گرفته نمی‌شوند و rate-limitها روی bucket اشتراکی می‌افتند (fail-closed).
#   تنظیم‌شده = XFFِ پروکسی معتمد (آخرین هاپ) به‌عنوان IP کلاینت پذیرفته می‌شود.
#   چند عضو با کاما. IPv4 با prefix 1-32 و IPv6 با prefix 1-128 (تطبیق باینری).
#   ⚠️ «/0» و اسلش انتهایی («10.0.0.1/») عمداً رد می‌شوند و عضو نامعتبر با
#   هشدار بلند نادیده گرفته می‌شود (سکوت مقابل تنظیم‌غلط ممنوع — CR-4/55-c).
#   پیش‌نیاز: پورت اپ فقط از پروکسی معتمد در دسترس باشد (bind/firewall).
# TRUSTED_PROXY_CIDR="127.0.0.1/32"
# MOCK_LATENCY_MS=0
# ALLOW_MOCKS_IN_PRODUCTION=1
#   فقط برای دموی staging بدون درگاه واقعی: providerهای mock را در بیلد production
#   فعال می‌کند (پرداخت آزمایشی + پیامک کنسول + devCode در پاسخ OTP).
#   پیش‌فرض قفل — در سرور production واقعی هرگز ست نکنید.
